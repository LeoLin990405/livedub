{
  "name": "livedub",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "本地优先的实时同传引擎：看教学视频时流式 ASR -> 增量翻译 -> 克隆音色配音 + 双语字幕（Chrome 扩展 + 本地工作台，零运行时依赖）",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node engine/server.mjs",
    "studio": "node engine/server.mjs --open",
    "doctor": "node scripts/doctor.mjs",
    "batch": "node scripts/batch.mjs",
    "demo": "node scripts/make-demo.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:core": "node --test tests/core.test.mjs tests/pipeline.test.mjs",
    "demo:video": "node scripts/make-demo.mjs",
    "demo:batch": "node scripts/batch.mjs",
    "lint": "node scripts/lint.mjs",
    "check": "node scripts/lint.mjs && node --test tests/*.test.mjs",
    "start:fast": "LIVEDUB_PROFILE=fast node engine/server.mjs",
    "batch:fast": "LIVEDUB_PROFILE=fast node scripts/batch.mjs --out demo-fast --no-burn",
    "demo:fast": "LIVEDUB_PROFILE=fast node scripts/batch.mjs --out demo-fast",
    "start:cloud": "LIVEDUB_PROFILE=cloud node engine/server.mjs",
    "batch:cloud": "LIVEDUB_PROFILE=cloud node scripts/batch.mjs --out demo-cloud --no-burn",
    "demo:cloud": "LIVEDUB_PROFILE=cloud node scripts/batch.mjs --out demo-cloud",
    "build:macos": "bash scripts/build-macos.sh",
    "test:macos": "node --test tests/macos.test.mjs",
    "note": "node scripts/note.mjs",
    "start:notes": "node engine/server.mjs --open",
    "build:ocr": "bash scripts/build-ocr.sh --check",
    "note:vision": "node scripts/note.mjs --screenshot"
  },
  "license": "MIT",
  "keywords": [
    "simultaneous-interpretation",
    "realtime-translation",
    "speech-recognition",
    "whisper",
    "tts",
    "subtitles",
    "live-captioning",
    "chrome-extension",
    "lecture",
    "education",
    "local-first",
    "nodejs"
  ],
  "author": "livedub contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeoLin990405/livedub.git"
  },
  "bugs": {
    "url": "https://github.com/LeoLin990405/livedub/issues"
  },
  "homepage": "https://github.com/LeoLin990405/livedub#readme"
}
